---
import Mono from "@/components/Mono.astro";
import Pulse from "@/components/Pulse.astro";
import SectionHead from "@/components/SectionHead.astro";
import Card from "@/components/ui/Card.astro";

const SOCIAL: ReadonlyArray<readonly [string, string, string]> = [
  ["GITHUB", "github.com/dede-saputra", "https://github.com/dede-saputra"],
  [
    "LINKEDIN",
    "in/dede-saputra",
    "https://www.linkedin.com/in/dede-saputra-6b4686424/",
  ],
  ["RESUME", "Download CV (PDF)", "/Dede-Saputra-Curriculum-Vitae.pdf"],
];

const EMAIL = "saputradede@outlook.co.id";
---

<section id="contact" data-screen-label="05 Contact" class="py-20">
  <SectionHead n="05." label="CONTACT" anchor="contact">
    <p>
      I am currently open to new opportunities in
      <span class="text-white"> Network Infrastructure, Telecommunications, and related engineering roles</span>.
    </p>

    <p>
      With hands-on experience in network operations and a background in
      <span class="text-white"> Electrical Engineering</span>,
      I am interested in opportunities where I can contribute, learn, and continue growing.
    </p>
  </SectionHead>

  <div class="grid md:grid-cols-3 gap-3 mt-4">
    {/* Kartu Utama Email */}
    <Card
      as="a"
      href={`mailto:${EMAIL}`}
      hover
      glow="top-left"
      padding="lg"
      class="md:col-span-2 group block cursor-pointer"
    >
      <Mono class="text-primary">EMAIL COMMUNICATION</Mono>
      
      <p class="mt-4 text-white text-xl md:text-4xl tracking-tight leading-tight break-all">
        {EMAIL}
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <button
          type="button"
          id="copy-email-btn"
          data-email={EMAIL}
          class="inline-flex items-center gap-2 text-muted-foreground hover:text-primary transition-colors cursor-pointer"
        >
          <Mono id="copy-text">COPY EMAIL ADDRESS</Mono>
          <span id="copy-icon"> </span>
        </button>

        <span class="text-muted-foreground/40 hidden sm:inline">|</span>

        <div class="inline-flex items-center gap-2 text-muted-foreground group-hover:text-primary transition-colors">
          <Mono>OPEN MAIL APP</Mono>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </div>
    </Card>

    {/* Kartu Inquiry & Social Links */}
    <Card padding="lg">
      <Mono class="text-primary">INQUIRY STATUS</Mono>

      <div class="mt-4 flex items-center gap-2.5">
        <Pulse />
        <span class="text-white text-sm md:text-base font-medium">
          Open to New Opportunities
        </span>
      </div>

      <p class="mt-4 text-muted-foreground text-sm">
        Thank you for reaching out. I aim to respond to all inquiries as quickly as possible.
      </p>

      <div class="mt-6 space-y-2">
        {
          SOCIAL.map(([k, v, h]) => (
            <a
              href={h}
              target="_blank"
              rel="noopener noreferrer"
              class="group grid grid-cols-3 items-baseline gap-2 py-1.5 border-b border-border hover:border-primary/40 transition-colors"
            >
              <Mono class="text-muted-foreground col-span-1">{k}</Mono>
              <span class="text-foreground/80 text-xs group-hover:text-primary transition-colors col-span-2 break-all">
                {v}
              </span>
            </a>
          ))
        }
      </div>
    </Card>
  </div>
</section>

<script>
  const copyBtn = document.getElementById("copy-email-btn");
  const copyText = document.getElementById("copy-text");

  copyBtn?.addEventListener("click", (e) => {
    e.preventDefault();
    e.stopPropagation();

    const email = copyBtn.getAttribute("data-email");
    if (email) {
      navigator.clipboard.writeText(email).then(() => {
        if (copyText) {
          const originalText = copyText.textContent;
          copyText.textContent = "COPIED TO CLIPBOARD!";
          
          setTimeout(() => {
            copyText.textContent = originalText;
          }, 2000);
        }
      });
    }
  });
</script>