---
import Mono from "@/components/Mono.astro";
import Reveal from "@/components/Reveal.astro";
import SectionHead from "@/components/SectionHead.astro";
import Badge from "@/components/ui/Badge.astro";
import Card from "@/components/ui/Card.astro";

const NETWORK_EXPOSURE = [
  "Telecommunications",
  "Network Monitoring",
  "DWDM / ASON",
  "MPLS",
  "GPON",
  "Metro Ethernet",
  "VSAT",
  "Radio Link",
  "Optical Fault Isolation",
  "Multi-Vendor Troubleshooting",
];

const ENGINEERING_EXPOSURE = [
  "Industrial Instrumentation",
  "Power Distribution (MDP/SDP)",
  "Electronics",
  "Python",
  "Linux",
  "Computer Vision",
  "NVIDIA CUDA",
  "OpenCV",
  "MediaPipe",
  "MQTT",
  "System Integration",
];
---

<section data-screen-label="02 About">
  <SectionHead n="02." label="ABOUT" anchor="about">
    <p>
      Electrical Engineering background with hands-on experience in
      <span class="text-white"> Network Infrastructure and Telecommunications</span>,
      with a primary focus on network monitoring, transmission systems, and infrastructure operations.
    </p>

    <p>
      My professional experience includes
      <span class="text-white"> DWDM/ASON, MPLS, GPON, Metro Ethernet, and Radio Link</span> networks across multi-vendor environments, with experience in network monitoring,
      incident troubleshooting, optical fault isolation, and performance analysis.
    </p>

    <p>
      My academic and engineering projects have also provided practical experience in
      <span class="text-white"> electronics, instrumentation, Python, Linux, Computer Vision,
      NVIDIA CUDA, and system integration</span>.
    </p>

    <p>
      I am currently focused on growing my career in
      <span class="text-white"> Network Infrastructure and Telecommunications</span>,
      while remaining open to related engineering opportunities where I can contribute
      my technical experience and multidisciplinary background.
    </p>
  </SectionHead>

  <div class="mt-12 grid md:grid-cols-3 gap-4 max-w-4xl">
    <Card padding="sm" hover>
      <Mono class="text-primary">EDUCATION</Mono>

      <p class="mt-3 text-white text-base">
        Bachelor of Electrical Engineering (S.T.)
      </p>

      <p class="mt-1 text-muted-foreground text-sm">
        Universitas Trisakti · Diploma from Politeknik Negeri Padang
      </p>
    </Card>

    <Card padding="sm" hover>
      <Mono class="text-primary">FOCUS</Mono>

      <p class="mt-3 text-white text-base">
        Network Infrastructure
      </p>

      <p class="mt-1 text-muted-foreground text-sm">
        Telecommunications · Network Monitoring · Transmission Systems
      </p>
    </Card>

    <Card padding="sm" hover>
      <Mono class="text-primary">LOCATION</Mono>

      <p class="mt-3 text-white text-base">
        Depok, Indonesia
      </p>

      <p class="mt-1 text-muted-foreground text-sm">
        Open to engineering opportunities
      </p>
    </Card>
  </div>

  <Reveal>
    <div class="mt-12">
      <Mono class="text-foreground/45 mb-4 block">
        TECHNICAL EXPOSURE
      </Mono>

      <div class="space-y-6 max-w-3xl">
        <div>
          <Mono class="text-primary mb-3 block">
            TELECOMMUNICATIONS & NETWORK INFRASTRUCTURE
          </Mono>

          <div class="flex flex-wrap gap-x-2 gap-y-2">
            {NETWORK_EXPOSURE.map((s) => <Badge variant="outline">{s}</Badge>)}
          </div>
        </div>

        <div>
          <Mono class="text-primary mb-3 block">
            ENGINEERING & TECHNOLOGY
          </Mono>

          <div class="flex flex-wrap gap-x-2 gap-y-2">
            {ENGINEERING_EXPOSURE.map((s) => <Badge variant="outline">{s}</Badge>)}
          </div>
        </div>
      </div>
    </div>
  </Reveal>
</section>