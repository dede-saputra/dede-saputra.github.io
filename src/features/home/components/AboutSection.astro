---
import Mono from "@/components/Mono.astro";
import Reveal from "@/components/Reveal.astro";
import SectionHead from "@/components/SectionHead.astro";
import Badge from "@/components/ui/Badge.astro";
import Card from "@/components/ui/Card.astro";

const STACK = [
  "DWDM / ASON",
  "MPLS",
  "GPON",
  "Metro Ethernet",
  "VSAT",
  "Telecommunications",
  "Industrial Instrumentation",
  "Power Distribution (MDP/SDP)",
  "Electronics",
  "Python",
  "Linux",
  "Computer Vision",
  "NVIDIA CUDA",
  "OpenCV",
  "MediaPipe",
  "MQTT",
];
---

<section data-screen-label="02 About">
  <SectionHead n="02." label="ABOUT" anchor="about">
    <p>
      Electrical Engineering background with hands-on experience in
      <span class="text-white"> telecommunications network operations, electrical infrastructure,
      </span> and embedded system integration.
    </p>

    <p>
      My professional experience focuses on
      <span class="text-white"> telecommunications network operations</span>,
      with hands-on involvement in DWDM/ASON transmission networks, MPLS,
      GPON, optical fault isolation, and multi-vendor network troubleshooting.
    </p>

    <p>
      Complemented by academic project experience in
      <span class="text-white"> computer vision and system integration</span>,
      developing Python-based applications on Linux for real-time image
      processing using OpenCV, MediaPipe, and NVIDIA CUDA optimization.
    </p>

    <p>
      My engineering foundation also includes
      <span class="text-white"> industrial instrumentation, low and medium voltage power distribution,
        testing and commissioning, and sensor systems
      </span>,
      with an emphasis on practical implementation and field reliability.
    </p>
  </SectionHead>

  <div class="mt-12 grid md:grid-cols-3 gap-4 max-w-4xl">
    <Card padding="sm" hover>
      <Mono class="text-primary">EDUCATION</Mono>

      <p class="mt-3 text-white text-base">
        Bachelor of Electrical Engineering (S.T.)
      </p>

      <p class="mt-1 text-muted-foreground text-sm">
        Universitas Trisakti · Diploma from Politeknik Negeri Padang
      </p>
    </Card>

    <Card padding="sm" hover>
      <Mono class="text-primary">FOCUS</Mono>

      <p class="mt-3 text-white text-base">
        Electronics 
      </p>

      <p class="mt-1 text-muted-foreground text-sm">
        Instrumentation · Sensor Interfacing · Telecommunications
      </p>
    </Card>

    <Card padding="sm" hover>
      <Mono class="text-primary">LOCATION</Mono>

      <p class="mt-3 text-white text-base">
        Depok, Indonesia
      </p>

      <p class="mt-1 text-muted-foreground text-sm">
        Open to engineering opportunities
      </p>
    </Card>
  </div>

  <Reveal>
    <div class="mt-12">
      <Mono class="text-foreground/45 mb-4 block">
        CORE TECHNOLOGIES
      </Mono>

      <div class="flex flex-wrap gap-x-2 gap-y-2 max-w-3xl">
        {STACK.map((s) => <Badge variant="outline">{s}</Badge>)}
      </div>
    </div>
  </Reveal>
</section>