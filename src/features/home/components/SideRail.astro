---
/*
 * Section navigation configuration
 * Each ID must match the ID of the corresponding section.
 */
const SECTIONS = [
  {
    id: "intro",
    label: "INTRO",
    icon: `<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>`,
  },
  {
    id: "about",
    label: "ABOUT",
    icon: `<circle cx="12" cy="7" r="4"/><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>`,
  },
  {
    id: "projects",
    label: "ACADEMIC PROJECTS",
    icon: `<path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/>`,
  },
  {
    id: "academic",
    label: "ACADEMIC HIGHLIGHTS",
    icon: `<path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>`,
  },
  {
    id: "contact",
    label: "CONTACT",
    icon: `<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>`,
  },
];
---

<!-- ========================================================= -->
<!-- Desktop Navigation                                        -->
<!-- ========================================================= -->

<nav
  aria-label="Section navigation"
  class="hidden lg:flex fixed left-8 top-1/2 -translate-y-1/2 z-30 flex-col gap-1"
>
  {
    SECTIONS.map((s, i) => (
      <a
        href={`#${s.id}`}
        data-rail-link={s.id}
        class="group flex items-center gap-3 py-2.5 pr-2"
      >
        <!-- Indicator line -->
        <span
          class="block h-px w-5 bg-foreground/30
                 group-hover:w-8
                 group-hover:bg-foreground/55
                 group-data-active:w-11
                 group-data-active:bg-primary
                 group-data-active:group-hover:bg-primary
                 transition-all duration-500"
        />

        <!-- Label (UKURAN FONT DIUBAH DARI text-xs MENJADI text-sm) -->
        <span
          class="font-mono text-sm uppercase tracking-widest
                 text-foreground/30
                 group-hover:text-foreground/80
                 group-data-active:text-primary
                 group-data-active:group-hover:text-primary
                 transition-colors"
        >
          0{i + 1}. {s.label}
        </span>
      </a>
    ))
  }
</nav>

<!-- ========================================================= -->
<!-- Mobile / Tablet Navigation                                -->
<!-- ========================================================= -->

<nav
  aria-label="Section navigation"
  class="lg:hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-30
         flex items-center gap-1 p-1
         bg-background/80 backdrop-blur-md
         border border-border rounded-full"
>
  {
    SECTIONS.map((s) => (
      <a
        href={`#${s.id}`}
        data-rail-link={s.id}
        aria-label={s.label}
        class="group inline-flex items-center justify-center
               w-8 h-8 rounded-full"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="w-4 h-4
                 text-foreground/30
                 group-hover:text-foreground/80
                 group-data-active:text-primary
                 transition-colors"
          set:html={s.icon}
        />
      </a>
    ))
  }
</nav>

<!-- ========================================================= -->
<!-- Active Section Detection                                  -->
<!-- ========================================================= -->

<script>
  const links =
    document.querySelectorAll<HTMLAnchorElement>("[data-rail-link]");

  const sectionIds = Array.from(links)
    .map((link) => link.dataset.railLink)
    .filter((id): id is string => Boolean(id));

  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((element): element is HTMLElement => element !== null);

  const setActive = (id: string) => {
    links.forEach((link) => {
      if (link.dataset.railLink === id) {
        link.setAttribute("data-active", "");
      } else {
        link.removeAttribute("data-active");
      }
    });
  };

  const updateActiveSection = () => {
    if (window.scrollY < 100) {
      setActive("intro");
      return;
    }

    const referencePoint = window.innerHeight * 0.4;
    let activeSection = sections[0];

    for (const section of sections) {
      const rect = section.getBoundingClientRect();
      if (rect.top <= referencePoint) {
        activeSection = section;
      } else {
        break;
      }
    }

    if (activeSection) {
      setActive(activeSection.id);
    }
  };

  window.addEventListener("scroll", updateActiveSection, {
    passive: true,
  });

  window.addEventListener("resize", updateActiveSection);

  updateActiveSection();
</script>