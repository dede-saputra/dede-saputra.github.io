---
import "../styles/global.css";
import { JOB_TITLE } from "@/config/constants";

type Props = {
  title?: string;
  description?: string;
};

const { title: pageTitle, description: pageDescription } = Astro.props;

const defaultTitle = "Dede Saputra · Electrical Engineering";
const defaultOgTitle = `Dede Saputra | ${JOB_TITLE}`;
const defaultDescription =
  "Electrical Engineering professional with a multidisciplinary background in Telecommunications, Sensor Interfacing, Networking, and Deep Learning.";

const finalTitle = pageTitle ?? defaultTitle;
const finalOgTitle = pageTitle ?? defaultOgTitle;
const finalDescription = pageDescription ?? defaultDescription;

const logoUrl = "/logo.svg";
const siteUrl = "https://dede-saputra.github.io/";
const ogType = "website";
const ogSiteName = "Dede Saputra | Portfolio";

const keywords =
  "Dede Saputra, Electrical Engineering, Telecommunications, Network Engineer, RAN Integration, DWDM, MPLS, VSAT, Optical Transmission, Ethernet, Fiber Optic, Networking, TCP/IP, Routing, Switching, VLAN, Huawei, ZTE, Cisco, Python, OpenCV, C++, MQTT, ESP32, Computer Vision, Deep Learning, CUDA, PyTorch, Linux, Ubuntu, Wireshark, Grafana, Git";

const canonicalURL = new URL(Astro.url.pathname, siteUrl);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Dede Saputra",
  url: siteUrl,
  sameAs: [
    "https://github.com/dede-saputra",
    "https://www.linkedin.com/in/dede-saputra-6b4686424/",
  ],
  jobTitle: JOB_TITLE,
  description: defaultDescription,
  image: new URL(logoUrl, siteUrl).href,
  knowsAbout: [
    "Electrical Engineering",
    "Telecommunications",
    "Radio Access Network",
    "RAN Integration",
    "DWDM",
    "MPLS",
    "VSAT",
    "Optical Transmission",
    "Fiber Optic",
    "Ethernet",
    "Networking",
    "TCP/IP",
    "Routing",
    "Switching",
    "Huawei",
    "ZTE",
    "Cisco",
    "Python",
    "OpenCV",
    "Computer Vision",
    "Deep Learning",
    "CUDA",
    "PyTorch",
    "MQTT",
    "ESP32",
    "Linux",
    "Wireshark",
    "Grafana",
  ],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Dede Saputra Portfolio",
  url: siteUrl,
  description: defaultDescription,
  author: "Dede Saputra",
};

const grainSvg = `url("data:image/svg+xml;utf8,<svg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='0.6'/></svg>")`;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{finalTitle}</title>

    <meta name="description" content={finalDescription} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Dede Saputra" />

    <link rel="canonical" href={canonicalURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Open Graph tags -->
    <meta property="og:title" content={finalOgTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(logoUrl, siteUrl)} />
    <meta property="og:site_name" content={ogSiteName} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalOgTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={new URL(logoUrl, siteUrl)} />

    <link rel="icon" type="image/svg+xml" href={logoUrl} sizes="any" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- JSON-LD Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify([personSchema, websiteSchema])}
    />
  </head>

  <body class="bg-background text-foreground font-sans">
    <!-- Atmosphere -->
    <div
      class="pointer-events-none fixed inset-0 z-0 overflow-hidden"
      aria-hidden="true"
    >
      <div
        class="absolute -top-[10vh] md:-top-[20vh] left-1/2 -translate-x-1/2 w-[180vw] md:w-[120vw] h-[70vh] md:h-[90vh] rounded-full blur-3xl radial-center from-primary/35 md:from-primary/22 to-transparent to-65% md:to-60%"
      />
      <div
        class="absolute top-[55vh] md:top-[60vh] -left-[20vw] md:-left-[10vw] w-[110vw] md:w-[70vw] h-[60vh] md:h-[70vh] rounded-full blur-3xl radial-center from-primary/18 md:from-primary/10 to-transparent to-65%"
      />
      <div
        class="absolute inset-0 radial-from-bottom from-black/60 to-transparent to-75%"
      />
      <div
        class="absolute inset-0 opacity-[0.03] mix-blend-overlay"
        style={`background-image: ${grainSvg};`}
      />
    </div>

    <main class="relative z-10 min-h-screen overflow-x-clip">
      <slot />
    </main>
  </body>
</html>